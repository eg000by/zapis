# Папка для одноразовых скриптов остаётся вне репозитория, кроме рабочих команд БД.
# (Именно /scripts/*, а не /scripts: исключённую папку обратно уже не «раз-исключить».)
/scripts/*
!/scripts/backup.mjs
!/scripts/restore.mjs

